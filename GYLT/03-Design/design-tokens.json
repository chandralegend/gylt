{
  "name": "GYLT implementation design tokens",
  "version": "2.0.0",
  "capturedAt": "2026-11-06",
  "supersedes": "1.0.0 (original prototype). The v1 source is preserved in ../04-Prototype/dist-v1-original/.",
  "format": "Descriptive JSON handoff; not a DTCG interchange schema or generated theme package.",
  "sources": {
    "css": "../04-Prototype/dist/app.css",
    "javascript": "../04-Prototype/dist/app.js",
    "specification": "DESIGN-SPECIFICATION.md",
    "note": "Values are the CSS custom properties at the top of app.css. There are no late cascade overrides in v2; component styles reference these tokens directly."
  },
  "rules": {
    "accent": "One accent hue (coral). Spent only on the primary action, the active state and progress. Text that must read as accent uses accentText for contrast.",
    "greys": "One warm grey family. No sage or cool greys.",
    "shape": "Actions are capsules; cards and sheets 24; grouped lists, inputs and tickets 14; small icon tiles 10; app icons 22.5% of their size.",
    "spacing": "4pt base. Screen gutter 20.",
    "type": "iOS type ramp. One display size per screen. Tabular numerals for anything that counts.",
    "labels": "One label per intent: start = \"Let's go\"; resume = \"Back to my walk\"; smaller option = \"Do the N-minute version\"; plan change = \"Change the plan\"; confirm in sheets = \"Save\" / \"Done\".",
    "themes": "Planning screens follow the system light/dark setting. Focus screens (intervention, session, blocked) are always dark."
  },
