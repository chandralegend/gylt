      "durationMs": 260,
      "from": {
        "opacity": 0,
        "scale": 0.985
      },
      "appliesTo": [
        "intervention",
        "session",
        "blocked",
        "complete"
      ]
    },
    "sheetEntry": {
      "durationMs": 320,
      "fromTranslateY": "100%"
    },
    "sheetExit": {
      "durationMs": 180,
      "easing": "ease-in"
    },
    "overlayFade": {
      "inMs": 200,
      "outMs": 160
    },
    "pressFeedback": {
      "buttonScale": 0.97,
      "cardScale": 0.98,
      "sessionControlScale": 0.95,
      "listRow": "background highlight, no scale",
      "durationMs": 120
    },
    "switchKnob": {
      "durationMs": 250
    },
    "toast": {
      "durationMs": 250,
      "fromScale": 0.97,
      "fromTranslateYPx": 16
    },
    "voiceWave": {
      "durationMs": 600,
      "alternate": true,
      "perBarDelayMs": 35,
      "scaleYRange": [
        0.45,
        1.15
      ]
    },
    "timerStroke": {
      "durationMs": 250,
      "easing": "linear"
    },
    "reducedMotion": "Animations and transitions collapse to 0.01ms."
  },
