        "cssVariable": "--elev"
      }
    },
    "darkScopes": [
      ":root[data-theme=\"dark\"]",
      "@media (prefers-color-scheme: dark) :root:not([data-theme=\"light\"])",
      ".screen.dark",
      ".device.dark"
    ],
    "appBadges": {
      "instagram": "linear-gradient(40deg,#FCA95C,#E0647E 50%,#9D69C3)",
      "tiktok": "#111111",
      "youtube": "#E8453C"
    },
    "contrastNotes": "label2 on bg: about 5.6:1 light, about 7:1 dark. label3 is for inactive tab glyphs and decoration only, not body text. Coral is never used as small text on light surfaces; accentText (#C23F20) is used instead."
  },
