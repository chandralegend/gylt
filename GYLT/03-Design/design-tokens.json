      "Reduced-motion media query",
      "44px minimum tap targets on interactive controls",
      "Accessible labels on icon-only controls",
      "role=switch with aria-checked on switches",
      "On-screen text for spoken coach lines",
      "Self-reported completion labels",
      "Modal focus trap and Escape to close"
